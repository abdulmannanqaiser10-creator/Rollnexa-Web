# Database
# Neon/Postgres connection string. Prefer sslmode=verify-full (current pg-secure behavior).
# Credentials/host stay the same; lib/db.ts also normalizes prefer/require/verify-ca → verify-full.
DATABASE_URL=

# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match the URL you open in the browser (e.g. http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Important: do not put empty DATABASE_URL / BETTER_AUTH_* keys in .env.local
# Empty values in .env.local override .env and break registration/login.

# Local development admin bootstrap (optional — never commit real passwords)
# Run: npm run seed:admin
DEV_ADMIN_NAME=Rollnexa
DEV_ADMIN_EMAIL=lexcoresolutions@gmail.com
DEV_ADMIN_PASSWORD=

# Cloudinary (optional — without these, machine images save locally to /public/uploads/machines)
# Do not leave empty CLOUDINARY_* keys in .env.local; empty values override and break config.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=

# Payments (optional — provider-specific secrets; never commit real values)
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
