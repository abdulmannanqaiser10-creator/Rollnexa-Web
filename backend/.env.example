# Database
# Local MongoDB connection string. Start MongoDB locally before running the app.
MONGODB_URI=mongodb://127.0.0.1:27018/rollnexa_marketplace?replicaSet=rs0


# Authentication
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match the URL you open in the browser (e.g. http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Public site URL used for SEO canonicals, sitemap, Open Graph (production: https://rollnexa.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Important: do not put empty MONGODB_URI / BETTER_AUTH_* keys in .env.local
# Empty values in .env.local override .env and break registration/login.

# Designated admin bootstrap (local/ops — never commit real passwords)
# Run: npm run seed:admin
# Prefer ADMIN_*; DEV_ADMIN_* remains supported for compatibility.
ADMIN_NAME=Rollnexa Admin
ADMIN_EMAIL=admin@rollnexa.com
ADMIN_PASSWORD=12345678
DEV_ADMIN_NAME=Rollnexa Admin
DEV_ADMIN_EMAIL=admin@rollnexa.com
DEV_ADMIN_PASSWORD=12345678

# Cloudinary (optional — without these, machine images save to frontend/data/machine-uploads and are served via /api/storage/machines)
# Do not leave empty CLOUDINARY_* keys in .env.local; empty values override and break config.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional override for local machine upload directory (default: frontend/data/machine-uploads)
# MACHINE_UPLOAD_DIR=

# Email
RESEND_API_KEY=
FROM_EMAIL=
APP_NAME=Rollnexa
APP_URL=http://localhost:3000

# OAuth (backend-only secrets — never expose client secrets in frontend)
# Callback URLs (register in each provider console):
#   Google:    {BETTER_AUTH_URL}/api/auth/callback/google
#   Facebook:  {BETTER_AUTH_URL}/api/auth/callback/facebook
#   Apple:     {BETTER_AUTH_URL}/api/auth/callback/apple
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Optional — required for native Apple Sign In
APPLE_APP_BUNDLE_IDENTIFIER=

# Payments (Safepay hosted checkout; keep merchant secrets server-side)
PAYMENT_PROVIDER=manual
# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
# Get the webhook secret from Safepay Developer Dashboard > Webhooks.
PROMOTION_CREDIT_PACKAGE_SLUG=featured
CRON_SECRET=
