{
  "name": "rollnexa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "db:generate": "node scripts/prisma-generate-safe.js",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx scripts/verify-user-schema.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:seller": "tsx scripts/create-seller.ts",
    "migrate:auth-issuer": "tsx scripts/migrate-account-issuer.ts",
    "seed:plans": "tsx scripts/seed-subscription-plans.ts",
    "seed:promotions": "tsx scripts/seed-promotion-packages.ts",
    "test:admin-auth": "tsx scripts/test-admin-auth.ts",
    "test:qa": "tsx scripts/qa-suite.ts"
  },
  "dependencies": {
    "@better-auth/utils": "^0.4.2",
    "@prisma/client": "^6.14.0",
    "better-auth": "^1.6.23",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "prisma": "^6.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
