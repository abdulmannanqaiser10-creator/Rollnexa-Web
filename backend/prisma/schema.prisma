generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ─── Enums ────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Condition {
  NEW
  USED
  REFURBISHED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  REJECTED
  PUBLISHED
  SOLD
  ARCHIVED
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum ReportType {
  FAKE_LISTING
  SCAM
  INAPPROPRIATE_CONTENT
  ABUSIVE_USER
  SUSPICIOUS_ACTIVITY
  OTHER
}

enum NotificationType {
  NEW_INQUIRY
  NEW_MESSAGE
  MACHINE_APPROVED
  MACHINE_REJECTED
  NEW_REVIEW
  ACCOUNT_UPDATE
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCESSFUL
  PAYMENT_FAILED
  INVOICE_READY
}

enum RelatedEntityType {
  MACHINE
  INQUIRY
  CONVERSATION
  REVIEW
  USER
  REPORT
  SUBSCRIPTION
  PAYMENT
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  STRIPE
  PAYPAL
  RAZORPAY
  PAYFAST
  SAFEPAY
}

enum PaymentMethod {
  CARD
  DEBIT_CARD
  WALLET
  BANK_TRANSFER
  OTHER
}

enum PromotionStatus {
  PENDING
  SCHEDULED
  ACTIVE
  EXPIRED
  CANCELLED
  FAILED
}

enum PromotionCreditType {
  GRANT
  USE
  REVERSAL
  EXPIRE
}

enum ActivityAction {
  USER_ROLE_UPDATED
  USER_STATUS_UPDATED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_ARCHIVED
  LISTING_MARKED_SOLD
  LISTING_FEATURED
  LISTING_UNFEATURED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  BRAND_CREATED
  BRAND_UPDATED
  BRAND_DELETED
  REPORT_UPDATED
  SUBSCRIPTION_PLAN_CREATED
  SUBSCRIPTION_PLAN_UPDATED
  SUBSCRIPTION_PLAN_ARCHIVED
}

// ─── User ─────────────────────────────────────────────────

model User {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          Role          @default(BUYER)
  accountStatus AccountStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  freeListingsUsed Int @default(0)
  listingMutationVersion Int @default(0)
  promotionCreditsBalance Int @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile             Profile?
  machines            Machine[]
  favorites           Favorite[]
  recentlyViewed      RecentlyViewed[]
  buyerInquiries      Inquiry[]          @relation("BuyerInquiries")
  sellerInquiries     Inquiry[]          @relation("SellerInquiries")
  buyerConversations  Conversation[]     @relation("BuyerConversations")
  sellerConversations Conversation[]     @relation("SellerConversations")
  sentMessages        Message[]          @relation("SentMessages")
  writtenReviews      Review[]           @relation("ReviewAuthor")
  receivedReviews     Review[]           @relation("ReviewSeller")
  moderatedReviews    Review[]           @relation("ReviewModerator")
  submittedReports    Report[]           @relation("ReportReporter")
  reportedReports     Report[]           @relation("ReportTargetUser")
  resolvedReports     Report[]           @relation("ReportResolver")
  rejectedMachines    Machine[]          @relation("MachineRejector")
  approvedMachines    Machine[]          @relation("MachineApprover")
  notifications       Notification[]
  sessions            Session[]
  accounts            Account[]
  subscriptions       UserSubscription[]
  payments            Payment[]
  activityLogs        ActivityLog[]
  promotions          ListingPromotion[]

  @@index([role, accountStatus])
  @@index([accountStatus, createdAt])
}

// ─── Profile ──────────────────────────────────────────────

model Profile {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String @db.ObjectId   @unique
  avatar          String?
  phone           String?
  companyName     String?
  bio             String?
  city            String?
  country         String?
  isDealerProfile Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Session (Better Auth) ────────────────────────────────

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Account (Better Auth) ────────────────────────────────

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String @db.ObjectId
  accountId             String
  providerId            String
  issuer                String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// ─── Verification (Better Auth) ───────────────────────────

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Category ─────────────────────────────────────────────

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machines Machine[]
}

// ─── Brand ────────────────────────────────────────────────

model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machines Machine[]
}

// ─── Machine ──────────────────────────────────────────────

model Machine {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String        @unique
  description String?
  price       Float
  year        Int?
  hours       Int?
  condition   Condition     @default(USED)
  location    String?
  status      ListingStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)

  rejectionReason      String?
  rejectedAt           DateTime?
  rejectedById         String? @db.ObjectId
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  approvedById         String? @db.ObjectId

  sellerId   String @db.ObjectId
  categoryId String @db.ObjectId
  brandId    String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand      Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  rejectedBy User?    @relation("MachineRejector", fields: [rejectedById], references: [id], onDelete: SetNull)
  approvedBy User?    @relation("MachineApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  images         MachineImage[]
  favorites      Favorite[]
  inquiries      Inquiry[]
  recentlyViewed RecentlyViewed[]
  conversations  Conversation[]
  reviews        Review[]
  reports        Report[]
  promotions     ListingPromotion[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([status, submittedForReviewAt])
  @@index([isFeatured, status])
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, year])
  @@index([price])
  @@index([createdAt])
  @@index([year])
}

// ─── Favorite ─────────────────────────────────────────────

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  machineId String @db.ObjectId
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId])
  @@index([machineId])
}

// ─── Recently Viewed ──────────────────────────────────────

model RecentlyViewed {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String @db.ObjectId
  machineId String @db.ObjectId
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([userId, machineId])
  @@index([userId, viewedAt])
  @@index([machineId])
}

// ─── Inquiry ──────────────────────────────────────────────

model Inquiry {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  message   String
  machineId String @db.ObjectId
  buyerId   String @db.ObjectId
  sellerId  String @db.ObjectId
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  buyer   User    @relation("BuyerInquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  seller  User    @relation("SellerInquiries", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

// ─── Conversation ─────────────────────────────────────────

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  buyerId   String @db.ObjectId
  sellerId  String @db.ObjectId
  machineId String @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  machine  Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerId, machineId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([machineId])
}

// ─── Message ──────────────────────────────────────────────

model Message {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  conversationId String @db.ObjectId
  senderId       String @db.ObjectId
  content        String
  attachmentUrl  String?
  attachmentType String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

// ─── MachineImage ─────────────────────────────────────────

model MachineImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  publicId  String?
  alt       String?
  sortOrder Int      @default(0)
  machineId String @db.ObjectId
  createdAt DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([machineId, sortOrder])
}

// ─── Review ───────────────────────────────────────────────

model Review {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  reviewerId      String @db.ObjectId
  machineId       String @db.ObjectId
  sellerId        String @db.ObjectId
  rating          Int
  content         String
  status          ReviewStatus @default(PUBLISHED)
  sellerReply     String?
  sellerRepliedAt DateTime?
  moderatedById   String? @db.ObjectId
  moderatedAt     DateTime?
  moderationNote  String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  reviewer    User    @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  machine     Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  seller      User    @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  moderatedBy User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([reviewerId, machineId])
  @@index([machineId, status, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([reviewerId, createdAt])
  @@index([status, createdAt])
}

// ─── Report ───────────────────────────────────────────────

model Report {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  type           ReportType
  status         ReportStatus @default(PENDING)
  reason         String
  description    String?
  reporterId     String @db.ObjectId
  reportedUserId String? @db.ObjectId
  machineId      String? @db.ObjectId
  adminNotes     String?
  resolvedById   String? @db.ObjectId
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  machine      Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  resolvedBy   User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([machineId])
}

model Notification {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  type              NotificationType
  title             String
  message           String
  isRead            Boolean            @default(false)
  readAt            DateTime?
  relatedEntityId   String?
  relatedEntityType RelatedEntityType?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}

// ─── Subscription Plans ───────────────────────────────────

model SubscriptionPlan {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String   @unique
  description       String?
  price             Float    @default(0)
  yearlyPrice       Float?
  currency          String   @default("USD")
  durationDays      Int      @default(30)
  maxListings       Int?
  featuredListings  Int      @default(0)
  promotionCredits  Int      @default(0)
  homepageFeatured  Boolean  @default(false)
  premiumBadge      Boolean  @default(false)
  analytics         Boolean  @default(false)
  prioritySupport   Boolean  @default(false)
  dealerProfile     Boolean  @default(false)
  topSearchPriority Boolean  @default(false)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions UserSubscription[]
  payments      Payment[]

  @@index([isActive, sortOrder])
}

model PromotionPackage {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String   @unique
  description    String?
  price          Float
  currency       String   @default("PKR")
  durationDays   Int
  priority       Int      @default(1)
  placementType  String   @default("SEARCH")
  badgeType      String   @default("NONE")
  isActive       Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  promotions     ListingPromotion[]

  @@index([isActive, displayOrder])
}

model ListingPromotion {
  id                 String          @id @default(auto()) @map("_id") @db.ObjectId
  sellerId           String          @db.ObjectId
  listingId          String          @db.ObjectId
  packageId          String          @db.ObjectId
  packageNameSnapshot String
  priceSnapshot      Float
  currencySnapshot   String
  durationSnapshot   Int
  prioritySnapshot   Int
  badgeTypeSnapshot  String
  status             PromotionStatus @default(PENDING)
  paymentId          String?         @db.ObjectId
  creditLedgerId     String?         @db.ObjectId
  startAt            DateTime?
  endAt              DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  seller             User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  listing            Machine         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  package            PromotionPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([sellerId, status])
  @@index([listingId, status, endAt])
  @@index([status, startAt, endAt])
}

model PromotionCreditLedger {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  sellerId             String             @db.ObjectId
  subscriptionId       String?            @db.ObjectId
  promotionId          String?            @db.ObjectId
  listingId            String?            @db.ObjectId
  type                 PromotionCreditType
  amount               Int
  billingCycleReference String?
  reason               String
  createdAt            DateTime           @default(now())

  @@index([sellerId, createdAt])
  @@index([subscriptionId, type])
  @@index([promotionId])
}

model FinancialAuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  event     String
  userId    String?  @db.ObjectId
  targetId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([targetId])
}

model UserSubscription {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  planId            String @db.ObjectId
  status            SubscriptionStatus @default(PENDING)
  startDate         DateTime?
  expiryDate        DateTime?
  remainingListings Int?
  autoRenew         Boolean            @default(false)
  billingCycle      String             @default("MONTHLY")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([status, expiryDate])
  @@index([planId])
}

model Payment {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  paymentId       String          @unique
  userId          String @db.ObjectId
  subscriptionId  String? @db.ObjectId
  planId          String @db.ObjectId
  amount          Float
  currency        String          @default("USD")
  paymentMethod   PaymentMethod   @default(CARD)
  paymentProvider PaymentProvider @default(MANUAL)
  paymentStatus   PaymentStatus   @default(PENDING)
  transactionId   String?
  invoiceNumber   String?         @unique
  receiptUrl      String?
  paidAt          DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan         SubscriptionPlan  @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([planId])
  @@index([subscriptionId])
}

model ActivityLog {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  action      ActivityAction
  description String
  targetId    String?
  ipAddress   String?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
  @@map("activityLogs")
}
