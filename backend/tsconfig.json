{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@prisma/generated": ["./generated/prisma/client"],
      "@prisma/generated/*": ["./generated/prisma/*"],
      "next/server": ["./src/shims/next-server.ts"],
      "next/headers": ["./src/shims/next-headers.ts"],
      "next/cache": ["./src/shims/next-cache.ts"],
      "react": ["./src/shims/react.ts"],
      "server-only": ["./src/shims/server-only.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "prisma/**/*.ts"],
  "exclude": ["node_modules", "generated", "src/lib/stores", "scripts/qa-suite.ts", "scripts/test-admin-auth.ts"]
}
