{
  "name": "rollnexa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node backend/scripts/dev.js",
    "db:mongo": "node backend/scripts/start-mongo-rs.js",
    "build": "npm --prefix backend run db:generate && npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push && npm --prefix backend run db:generate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:verify": "npm --prefix backend run db:verify",
    "seed:admin": "npm --prefix backend run seed:admin",
    "seed:plans": "npm --prefix backend run seed:plans",
    "test:admin-auth": "npm --prefix backend run test:admin-auth",
    "test:qa": "npm --prefix backend run test:qa"
  }
}
